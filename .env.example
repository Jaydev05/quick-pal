# ============================================================
# Jaydev Associates — environment variables
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# The values below are the project's own backend (Lovable Cloud)
# publishable keys — replace them with your project's values if
# you connect a different backend.
# ============================================================

# --- Backend / database (Lovable Cloud) ---
# Project identifier for the backend.
SUPABASE_PROJECT_ID="your-project-id"

# Full backend URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable (anon) key — safe to expose in the browser.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"

# --- Browser build (VITE_ prefixed; required for the client bundle) ---
# These must match the values above — Vite inlines them at build time.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"

# --- Optional, server-side only ---
# SUPABASE_SERVICE_ROLE_KEY — admin key that bypasses row-level security.
# NOT available on Lovable Cloud; do not fabricate a value.
# Only needed for privileged server operations on a self-hosted backend.
# SUPABASE_SERVICE_ROLE_KEY=""

# LOVABLE_CRON_SECRET / LOVABLE_CRON_SECRET_PREVIOUS — only required if you
# expose cron/webhook endpoints guarded by these secrets.
# LOVABLE_CRON_SECRET=""
# LOVABLE_CRON_SECRET_PREVIOUS=""